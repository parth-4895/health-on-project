PORT=4000
HOST=0.0.0.0
NODE_ENV=development
SUPABASE_URL=https://your-supabase-project-id.supabase.co
# Public anon key. The server uses it to check a returning patient's password when they accept an invite.
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
CLIENT_APP_URL=http://localhost:5173
OCR_SERVICE_URL=http://localhost:8000
# How long an upload waits for extraction (ms). Scans take ~10s a page on CPU.
OCR_TIMEOUT_MS=180000
# Shortest word in a report's patient name where a one-letter difference counts as an OCR misread.
OCR_NAME_TYPO_MIN_LENGTH=6
# How long a scan waits in memory for the uploader to answer a name mismatch (ms), and how many may wait at once.
OCR_PENDING_EXTRACTION_TTL_MS=600000
OCR_PENDING_EXTRACTION_MAX=100

# SMTP Configuration for Invite Emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@example.com

INVITE_TOKEN_TTL_HOURS=72
OCR_CONFIDENCE_REVIEW_THRESHOLD=0.85

# Logging: debug | info | warn | error | silent (default: debug in development, info otherwise)
LOG_LEVEL=debug
# pretty (human-readable) | json (one object per line, for log shippers)
LOG_FORMAT=pretty

# Demo only: clinicians can verify their own account from the
# verification-pending page in local development.
# Requires NODE_ENV=development and DEMO_SELF_VERIFY=true.
# Non-development environments (production, staging) unconditionally refuse
# self-verification even if this flag is set. Production accounts must be verified
# by an administrator using: npm run verify-clinician -- <email>
DEMO_SELF_VERIFY=true

# Consultation Audio Pipeline
# Required outside NODE_ENV=development/test: startup fails without it.
# An unset NODE_ENV counts as production.
SESSION_TOKEN_SECRET=replace-with-a-secure-random-secret
SESSION_TOKEN_TTL_SEC=7200
CHUNK_MIN_SEC=15
CHUNK_HARD_CAP_SEC=25
PAUSE_MS=500
SILENCE_DBFS=-45
END_DEADLINE_SEC=15
ORCHESTRATOR_POLL_MS=1000
ROOM_CODE_TTL_MIN=10
# Pre-consultation STT test: calls per user per window (uses paid STT credit)
STT_TEST_MAX_PER_WINDOW=5
STT_TEST_WINDOW_MS=600000
CHUNK_MAX_BYTES=2000000
TRANSCRIBE_CONCURRENCY=3
TRANSCRIBE_MAX_ATTEMPTS=3
STT_PROVIDER=sarvam
SARVAM_API_KEY=your-sarvam-api-key
WHISPER_SERVICE_URL=http://localhost:8001
# 'auto' or a language code such as en / hi
STT_DEFAULT_LANGUAGE=auto
# Whisper service guards (read by whisper-service/main.py)
WHISPER_ALLOWED_LANGUAGES=en,hi
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_LOG_PROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
WHISPER_VAD_THRESHOLD=0.6
GEMINI_API_KEY=your-gemini-api-key

DEDUPE_MIN_OVERLAP=0.5
DEDUPE_MIN_SIMILARITY=0.8
LOW_CONFIDENCE_THRESHOLD=0.65
NOISE_CONFIDENCE_FLOOR=0.25
CROSSTALK_PARTIAL_SIMILARITY=0.25
CROSSTALK_PARTIAL_LOUDNESS_DB=6
CROSSTALK_DOMINANT_LOUDNESS_DB=10

# Clinical Notes Drafting (Phase 8)
# DRAFT_MODEL_PROVIDER: 'gemini' | 'local' | 'fake'
DRAFT_MODEL_PROVIDER=gemini
GEMINI_DRAFT_MODEL=gemini-3.5-flash-lite
LOCAL_LLM_URL=http://localhost:11434/api/chat
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_LLM_THINK=false
DRAFT_TIMEOUT_MS=25000

# Patient Similarity Model (Decision Support)
# PATIENT_SIMILARITY_PROVIDER: 'gemini' | 'local' | 'fake'
PATIENT_SIMILARITY_PROVIDER=gemini
PATIENT_SIMILARITY_GEMINI_MODEL=gemini-3.5-flash-lite
PATIENT_SIMILARITY_EMBEDDING_MODEL=text-embedding-004
PATIENT_SIMILARITY_TOP_K=5
PATIENT_SIMILARITY_GEST_WINDOW_WEEKS=6
PATIENT_SIMILARITY_SHRINKAGE_K=4.5
PATIENT_SIMILARITY_SHRINKAGE_S0=0.32
PATIENT_SIMILARITY_ALPHA_STRUCTURED=0.45
PATIENT_SIMILARITY_BETA_SYMPTOMS=0.35
PATIENT_SIMILARITY_GAMMA_NARRATIVE=0.20


GEMINI_MODEL=gemini-flash-lite-latest
CHECKIN_LOOKBACK_DAYS=28
CHECKIN_AI_TIMEOUT_MS=15000

# Patient Device Metrics & Health Connect
DEVICE_METRICS_LOOKBACK_DAYS=28
DEVICE_METRICS_TRAJECTORY_DAYS=7
DEVICE_METRICS_MAX_SYNC_BATCH=60
ALERT_RESTING_HR_BPM=100
ALERT_BP_SYSTOLIC=140
ALERT_BP_DIASTOLIC=90
ALERT_MOBILITY_DROP_PERCENT=40
ALERT_SLEEP_DEFICIT_HOURS=5.5
ALERT_RAPID_WEIGHT_GAIN_KG=1.5


# In-app assistant (opens pages and records, fills forms). Off unless true.
ASSISTANT_ENABLED=false
# Server-owned multi-round routing (agent loop on by default; false means single requests only).
ASSISTANT_AGENT_LOOP=true
# Hosted deployments: set one long random signing key shared by all backend instances.
# Unset uses a process-local key; restarts/instance switches then expire pending actions.
ASSISTANT_CONTINUATION_SECRET=
# Phase 3: let it press buttons that save or send (always after the user confirms on a card).
# Off: it fills the form and the user presses the button.
ASSISTANT_ACTIONS_ENABLED=false
# ollama (local, native API) | gemini (Google; key in GEMINI_API_KEY or LLM_API_KEY) | openai-compatible (hosted or vLLM) | fake (tests)
# Hosted models receive what doctors type (names, clinical values): use one only with a data agreement in place.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_API_KEY=
LLM_MODEL=gemma4:e4b
# Optional planner model: Gemini Flash plans, Flash Lite navigates; empty uses main model.
LLM_PLANNER_MODEL=
# With LLM_PROVIDER=gemini: LLM_MODEL=gemini-flash-lite-latest (default) or gemini-flash-latest.
# Gemini only: second model tried once when the first is busy (empty = off), and thinking level (low | high | empty = default).
LLM_FALLBACK_MODEL=
LLM_THINKING_LEVEL=
# Ollama only: keep the model loaded between requests, and its context size (form controls need ~4k).
LLM_KEEP_ALIVE=15m
LLM_NUM_CTX=8192
# Cap on the model's reply (~30 tokens per step, ~15 per filled field) and most steps per request.
# Leave unset for Gemini (default 2048, since its thinking counts against the cap).
LLM_MAX_OUTPUT_TOKENS=512
ASSISTANT_MAX_STEPS=4
ASSISTANT_TIMEOUT_MS=15000
ASSISTANT_COLD_START_TIMEOUT_MS=90000
ASSISTANT_WARM_WINDOW_MS=600000
ASSISTANT_MAX_MESSAGE_CHARS=600
# One request can take several read-and-act rounds, each counted here.
ASSISTANT_RATE_LIMIT_PER_MINUTE=60
# Phase 5 page reading (doctors): most labels sent per page, actions per round, rounds per request,
# and the length of an app-help answer.
ASSISTANT_MAX_PAGE_ELEMENTS=120
ASSISTANT_MAX_PAGE_ACTIONS=8
ASSISTANT_MAX_ROUNDS=15
ASSISTANT_MAX_PAGE_VISITS=3
ASSISTANT_MAX_WRITTEN_ENTRIES=120
ASSISTANT_MEMORY_ITEMS=10
ASSISTANT_MEMORY_MAX_AGE_MIN=120
ASSISTANT_MAX_ACTION_REPEATS=2
ASSISTANT_REQUEST_TIMEOUT_MS=180000
ASSISTANT_MODEL_TIMEOUT_MS=30000
ASSISTANT_CONTINUATION_MAX_CHARS=32000
ASSISTANT_STALL_LIMIT=2
ASSISTANT_SETTLE_QUIET_MS=300
ASSISTANT_SETTLE_TIMEOUT_MS=3000
# Keep each verified checklist update visible before planning the next action.
ASSISTANT_PROGRESS_PAUSE_MS=500
ASSISTANT_SNAPSHOT_TOKEN_BUDGET=1500
ASSISTANT_MAX_ANSWER_CHARS=300
# Home BP is saved as separate systolic and diastolic rows; rows within this
# many milliseconds of each other are answered as one "systolic/diastolic" reading.
ASSISTANT_HOME_BP_PAIR_WINDOW_MS=300000
# Phase 2b: furthest ahead the assistant may fill an appointment date, and the
# zone used when the browser sends none (IANA name).
ASSISTANT_MAX_BOOKING_DAYS=365
ASSISTANT_DEFAULT_TIMEZONE=Asia/Kolkata
# Optional overrides for the fixed replies. Any health-related wording needs clinician sign-off.
# ASSISTANT_UNSUPPORTED_MESSAGE=
# ASSISTANT_UNAVAILABLE_MESSAGE=

# Optional server-side audio cache; Supabase remains persistent storage.
# Start locally: docker compose -f docker-compose.redis.yml up -d
CONSULT_AUDIO_CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
AUDIO_CACHE_TTL_SEC=1800
REDIS_CONNECT_TIMEOUT_MS=500
REDIS_COMMAND_TIMEOUT_MS=200
REDIS_RECONNECT_MAX_DELAY_MS=5000
REDIS_MAX_PENDING_COMMANDS=128
REDIS_MAXMEMORY_MB=256
# Compose publishes Redis on loopback only. Match REDIS_URL if this changes.
REDIS_PORT=6379

# Audio Retention Policy (hours after clinician draft approval)
AUDIO_RETENTION_AFTER_REVIEW_HOURS=24

# Patient Similarity Model Feature Flags
PATIENT_SIMILARITY_ENABLED=true
PATIENT_SIMILARITY_USE_SYNTHETIC_DATA=true

# Server-Side Storage Envelope Encryption (AES-256-GCM + RSA-OAEP)
# Generate a keypair with: npm run generate-keys --prefix server
STORAGE_ENCRYPTION_KEY_ID=v1
STORAGE_ENCRYPTION_RSA_PUBLIC_KEY=
STORAGE_ENCRYPTION_RSA_PRIVATE_KEY=
STORAGE_ENCRYPTION_ALLOW_LEGACY_FALLBACK=true
# Required outside NODE_ENV=development/test (startup fails without it, or SESSION_TOKEN_SECRET).
STORAGE_PROXY_HMAC_SECRET=replace-with-a-secure-random-secret
STORAGE_SIGNED_URL_TTL_SEC=600


ASSISTANT_MAX_REFUSED_ROUNDS=2

# Community Subsystem (In-Process on Render or standalone)
# Set to 'false' if running Identity/Safety/Worker on separate standalone services
COMMUNITY_AUTO_START_SERVICES=true
# Internal loopback ports for Identity and Safety services
COMMUNITY_IDENTITY_PORT=4101
COMMUNITY_SAFETY_PORT=4102
COMMUNITY_IDENTITY_URL=http://127.0.0.1:4101
COMMUNITY_SAFETY_URL=http://127.0.0.1:4102
# Shared secrets for internal authorization (at least 32 characters)
COMMUNITY_IDENTITY_SERVICE_KEY=replace-with-a-secure-random-identity-secret-at-least-32-chars
COMMUNITY_SAFETY_SERVICE_KEY=replace-with-a-secure-random-safety-secret-at-least-32-chars
# Database URLs (using dedicated least-privilege logins)
COMMUNITY_DATABASE_URL=postgresql://medbrief_api_login:password@db.example.supabase.co:5432/postgres?sslmode=verify-full
COMMUNITY_IDENTITY_DATABASE_URL=postgresql://medbrief_identity_login:password@db.example.supabase.co:5432/postgres?sslmode=verify-full
COMMUNITY_WORKER_DATABASE_URL=postgresql://medbrief_safety_login:password@db.example.supabase.co:5432/postgres?sslmode=verify-full
# Background jobs sweeper interval in ms (default: 30000ms = 30s)
COMMUNITY_WORKER_POLL_MS=30000
# Path to approved community rules JSON file (on Render, upload as a Secret File to /etc/secrets/community-rules.json)
COMMUNITY_RULES_FILE=/etc/secrets/community-rules.json
# Path to Firebase FCM service account JSON file (optional; on Render, upload as a Secret File to /etc/secrets/firebase-worker.json)
COMMUNITY_FCM_CREDENTIALS_FILE=
# LLM moderation provider: gemini | ollama
COMMUNITY_LLM_PROVIDER=gemini
COMMUNITY_GEMINI_MODEL=gemini-3.5-flash-lite
# LLM moderation bypass: true in local dev/testing; false in production
COMMUNITY_LLM_BYPASS=false
# LLM moderation inference timeout in milliseconds (default: 30000ms = 30s)
COMMUNITY_LLM_TIMEOUT_MS=30000

